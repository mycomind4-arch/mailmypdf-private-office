# Private Office server boundary
# Required for the internal workflow analysis/document endpoints.
PRIVATE_OFFICE_INTERNAL_API_KEY=replace-with-a-long-random-server-secret

# MailMyPDF fulfillment/document API
MAILMYPDF_API_URL=https://your-mailmypdf-api.example.com
MAILMYPDF_API_KEY=replace-with-server-only-api-key

# Server-only Supabase matter persistence
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-supabase-service-role-key

# Client-side Supabase (public)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-supabase-anon-key

# Stripe
STRIPE_SECRET_KEY=replace-with-stripe-secret-key

# ─── LLM Multi-Provider Configuration ───────────────────────────────────
# Gemini is the DEFAULT provider. The domain is provider-neutral.
# All LLM calls are server-side only. Never expose provider credentials to the browser.

# Default provider (gemini | openai | anthropic)
LLM_PROVIDER=gemini

# Intelligence mode (standard | enhanced | consensus | maximum-assurance)
# standard:          Gemini only, no fallback
# enhanced:          Gemini with fallback
# consensus:         Gemini + OpenAI with reconciliation
# maximum-assurance:  Gemini + OpenAI + Anthropic with full reconciliation
LLM_INTELLIGENCE_MODE=standard

# Prompt version for reproducibility
LLM_PROMPT_VERSION=1.0.0

# Global settings
LLM_FALLBACK_ENABLED=true
LLM_MAX_RETRIES=1
LLM_TIMEOUT_MS=30000
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048

# ── Gemini (DEFAULT) ────────────────────────────────────────────────────
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
# GEMINI_API_URL=https://generativelanguage.googleapis.com  # optional override

# ── OpenAI (optional) ────────────────────────────────────────────────────
# Required only for consensus or maximum-assurance modes.
# OPENAI_API_KEY=replace-with-openai-api-key
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_URL=https://api.openai.com  # optional override

# ── Anthropic (optional) ────────────────────────────────────────────────
# Required only for maximum-assurance mode.
# ANTHROPIC_API_KEY=replace-with-anthropic-api-key
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# ANTHROPIC_API_URL=https://api.anthropic.com  # optional override

# ── Operation-level policy overrides (optional) ────────────────────────
# Override the intelligence mode for specific operations.
# Values: standard | enhanced | consensus | maximum-assurance
# LLM_POLICY_CLASSIFY=standard
# LLM_POLICY_EXTRACT=standard
# LLM_POLICY_EXTRACT_TIMELINE=standard
# LLM_POLICY_ANALYZE=standard
# LLM_POLICY_ASSESS_RISK=enhanced
# LLM_POLICY_GENERATE_STRATEGY=standard
# LLM_POLICY_ASSIST_DRAFT=standard
# LLM_POLICY_RECONCILE=consensus
